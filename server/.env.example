# ===================================
# TeleClinic Environment Variables
# ===================================
# Copy this file to server/.env and fill in your values.
# Many of these settings can also be dynamically configured live in the Admin Portal (/admin/settings).

# -----------------------------------
# Server & Environment
# -----------------------------------
NODE_ENV=development
PORT=5000

# -----------------------------------
# Database (MongoDB)
# -----------------------------------
MONGO_URI=mongodb://localhost:27017/teleclinic
# Or MongoDB Atlas:
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/teleclinic?retryWrites=true&w=majority

# -----------------------------------
# Authentication & JWT
# -----------------------------------
JWT_SECRET=your-secure-jwt-secret-key-here
JWT_EXPIRES_IN=7d

# -----------------------------------
# Application URLs & CORS
# -----------------------------------
FRONTEND_URL=http://localhost:5173
APP_URL=http://localhost:5000

# -----------------------------------
# Transactional Email Providers
# -----------------------------------
# Configure your preferred mail provider via Admin Settings (/admin/settings) or fallbacks below:
# Supported options: resend | sendgrid | postmark | smtp
DEFAULT_MAIL_PROVIDER=resend
MAIL_FROM="TeleClinic <noreply@yourdomain.com>"

# 1. Resend API
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 2. Twilio SendGrid
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 3. Postmark Server Token
POSTMARK_SERVER_TOKEN=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# 4. SMTP (Brevo / Generic SMTP)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password

# -----------------------------------
# AI Intelligence Engine
# -----------------------------------
# Configure your active AI provider via Admin Settings (/admin/settings) or fallbacks below:
# Supported options: groq | openai | gemini
DEFAULT_AI_PROVIDER=groq

# 1. Groq (Default model: llama-3.3-70b-versatile)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 2. OpenAI (Default model: gpt-4o)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxx

# 3. Google Gemini (Default model: gemini-1.5-flash / gemini-2.0-flash)
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------
# E-Commerce & CRM Gateway Configuration
# -----------------------------------
# Configure via Admin Settings (/admin/settings):
# Supported options: vrio | sticky | checkoutchamp
DEFAULT_CRM_PROVIDER=vrio

# 1. Vrio CRM Gateway
VRIO_BASE_URL=https://api.vrio.app
VRIO_API_KEY=your-vrio-api-key
VRIO_CONNECTION_ID=1
VRIO_CAMPAIGN_ID=1
VRIO_ROUTE_ID=1
VRIO_SHIPPING_PROFILE_ID=1
VRIO_PAYMENT_METHOD_ID=1

# 2. sticky.io Gateway
STICKY_API_DOMAIN=yourbrand.sticky.io
STICKY_API_USERNAME=your-sticky-api-username
STICKY_API_PASSWORD=your-sticky-api-password

# 3. CheckoutChamp Gateway
CHECKOUTCHAMP_API_URL=https://api.checkoutchamp.com
CHECKOUTCHAMP_LOGIN_ID=your-checkoutchamp-login-id
CHECKOUTCHAMP_PASSWORD=your-checkoutchamp-password
