# Client Environment Variables
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000

# Optional: override the backup TURN relay credential used for WebRTC NAT
# traversal in video consultations. Falls back to a shared default account
# if unset.
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
