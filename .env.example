# ===================================
# TeleClinic Environment Variables
# ===================================
# Copy this file to server/.env and fill in values.

# -----------------------------------
# Server
# -----------------------------------
NODE_ENV=development
PORT=5000

# -----------------------------------
# MongoDB
# -----------------------------------
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/teleclinic?retryWrites=true&w=majority

# -----------------------------------
# JWT
# -----------------------------------
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=7d

# -----------------------------------
# URLs
# -----------------------------------
FRONTEND_URL=http://localhost:5173
APP_URL=http://localhost:5000

# -----------------------------------
# Email (Resend)
# -----------------------------------
# Note: RESEND_API_KEY and MAIL_FROM can be configured dynamically via Admin Portal (/admin/crm-settings).
# Fallback environment variables (optional):
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# MAIL_FROM="TeleClinic <noreply@yourdomain.com>"

# -----------------------------------
# Email (SMTP — Brevo / alternative)
# -----------------------------------
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password

# -----------------------------------
# AI (Groq)
# -----------------------------------
# Note: GROQ_API_KEY can be configured dynamically via Admin Portal (/admin/crm-settings).
# Fallback environment variable (optional):
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------
# Vrio CRM Gateway
# -----------------------------------
# Note: Vrio API Key is configured via Admin Settings in the database.
VRIO_BASE_URL=https://api.vrio.app
VRIO_CONNECTION_ID=1
VRIO_CAMPAIGN_ID=1
VRIO_ROUTE_ID=1
VRIO_SHIPPING_PROFILE_ID=1
VRIO_PAYMENT_METHOD_ID=1
